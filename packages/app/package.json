{
  "name": "@noa/app",
  "version": "0.1.0",
  "type": "module",
  "description": "Noa 应用壳：配置、内核装配、常驻宿主与 `noa` 可执行入口。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
