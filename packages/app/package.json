    "@noa/channel-qq": "workspace:*",
    "@noa/core": "workspace:*",
    "@noa/plugins": "workspace:*",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
