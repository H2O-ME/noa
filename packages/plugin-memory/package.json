{
  "name": "@noa/plugin-memory",
  "version": "0.1.0",
  "type": "module",
  "description": "记忆插件：MEMORY.md / USER.md 策展记忆 + 本地向量索引（记忆条目 + 历史会话语义检索）。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noa/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
