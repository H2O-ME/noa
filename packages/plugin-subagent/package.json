{
  "name": "@noa/plugin-subagent",
  "version": "0.1.0",
  "type": "module",
  "description": "子代理插件（advanced 档，按 spec 装载）：隔离子代理运行；缺失不影响主程序。",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noa/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
