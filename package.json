{
  "name": "noa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint packages",
    "dev": "pnpm --filter @noa/app dev",
    "start": "node packages/app/dist/index.mjs",
    "check": "pnpm lint && pnpm typecheck && vitest run --changed"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
